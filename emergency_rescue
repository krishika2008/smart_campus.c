
#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

#define MAX 100

typedef struct {
    char id[20];
    char location[50];
    int people;
    int level;
    int priority;
    char status[20];
} Emergency;

Emergency e[MAX];
int count = 0;

/* Read a complete line safely */
void readText(const char *message, char *text, int size) {
    printf("%s", message);

    if (fgets(text, size, stdin) == NULL ) {
        text[0] = '\0';
        return;
    }

    text[strcspn(text, "\r\n")] = '\0';
}

/* Read and validate an integer */
int readNumber(const char *message, int min, int max) {
    char input[100];
    char *end;
    long value;

    while (1) {
        readText(message, input, sizeof(input));

        value = strtol(input, &end, 10);

        while (isspace((unsigned char)*end)) {
            end++;
        }

        if (input[0] != '\0' && *end == '\0' &&
            value >= min && value <= max) {
            return (int)value;
        }

        printf("Invalid input! Enter a number from %d to %d.\n",
               min, max);
    }
}

/* Calculate emergency priority */
int calculatePriority(int level, int people) {
    int base;

    switch (level) {
        case 1: base = 100; break;
        case 2: base = 200; break;
        case 3: base = 300; break;
        case 4: base = 400; break;
        default: base = 0;
    }

    if (people > 99) {
        people = 99;
    }

    return base + people;
}

const char *levelName(int level) {
    switch (level) {
        case 1: return "Low";
        case 2: return "Medium";
        case 3: return "High";
        case 4: return "Critical";
        default: return "Unknown";
    }
}

void showLine(void) {
    printf("====================================================\n");
}

/* Register a new emergency */
void registerEmergency(void) {
    char id[20];
    char location[50];
    int people, level, i;

    if (count >= MAX) {
        printf("\nMaximum number of requests reached!\n");
        return;
    }

    printf("\n");
    showLine();
    printf("             REGISTER EMERGENCY\n");
    showLine();

    readText("Emergency ID: ", id, sizeof(id));

    if (id[0] == '\0') {
        printf("ID cannot be empty!\n");
        return;
    }

    for (i = 0; i < count; i++) {
        if (strcmp(e[i].id, id) == 0) {
            printf("This ID already exists!\n");
            return;
        }
    }

    readText("Location: ", location, sizeof(location));

    if (location[0] == '\0') {
        printf("Location cannot be empty!\n");
        return;
    }

    people = readNumber("People affected (1-9999): ", 1, 9999);

    printf("\n1. Low\n2. Medium\n3. High\n4. Critical\n");
    level = readNumber("Emergency level: ", 1, 4);

    strcpy(e[count].id, id);
    strcpy(e[count].location, location);

    e[count].people = people;
    e[count].level = level;
    e[count].priority = calculatePriority(level, people);

    strcpy(e[count].status, "Pending");

    count++;

    printf("\n[SUCCESS] Emergency registered!\n");
    printf("Priority score: %d\n",
           e[count - 1].priority);
}

/* Display emergencies in priority order */
void displayEmergencies(void) {
    Emergency sorted[MAX];
    Emergency temp;
    int i, j;

    printf("\n");
    showLine();
    printf("             EMERGENCY PRIORITY QUEUE\n");
    showLine();

    if (count == 0) {
        printf("No emergencies registered yet.\n");
        return;
    }

    memcpy(sorted, e, count * sizeof(Emergency));

    for (i = 0; i < count - 1; i++) {
        for (j = 0; j < count - i - 1; j++) {
            if (sorted[j].priority < sorted[j + 1].priority) {
                temp = sorted[j];
                sorted[j] = sorted[j + 1];
                sorted[j + 1] = temp;
            }
        }
    }

    for (i = 0; i < count; i++) {
        printf("\nID       : %s\n", sorted[i].id);
        printf("Location : %s\n", sorted[i].location);
        printf("Level    : %s\n", levelName(sorted[i].level));
        printf("People   : %d\n", sorted[i].people);
        printf("Priority : %d\n", sorted[i].priority);
        printf("Status   : %s\n", sorted[i].status);
        showLine();
    }
}

/* Search emergency by ID */
void searchEmergency(void) {
    char id[20];
    int i;

    printf("\n");
    readText("Enter Emergency ID: ", id, sizeof(id));

    for (i = 0; i < count; i++) {
        if (strcmp(e[i].id, id) == 0) {
            printf("\nEmergency Found!\n");
            showLine();
            printf("ID       : %s\n", e[i].id);
            printf("Location : %s\n", e[i].location);
            printf("Level    : %s\n", levelName(e[i].level));
            printf("People   : %d\n", e[i].people);
            printf("Priority : %d\n", e[i].priority);
            printf("Status   : %s\n", e[i].status);
            showLine();
            return;
        }
    }

    printf("Emergency ID not found.\n");
}

/* Update emergency status */
void updateStatus(void) {
    char id[20];
    int i, choice;

    printf("\n");
    readText("Enter Emergency ID: ", id, sizeof(id));

    for (i = 0; i < count; i++) {
        if (strcmp(e[i].id, id) == 0) {
            printf("\nCurrent status: %s\n", e[i].status);
            printf("1. Pending\n");
            printf("2. In Progress\n");
            printf("3. Completed\n");

            choice = readNumber("Select new status: ", 1, 3);

            if (choice == 1) {
                strcpy(e[i].status, "Pending");
            } else if (choice == 2) {
                strcpy(e[i].status, "In Progress");
            } else {
                strcpy(e[i].status, "Completed");
            }

            printf("[SUCCESS] Status updated!\n");
            return;
        }
    }

    printf("Emergency ID not found.\n");
}

/* Dashboard */
void dashboard(void) {
    int i;
    int critical = 0;
    int pending = 0;
    int completed = 0;
    int affected = 0;

    for (i = 0; i < count; i++) {
        if (e[i].level == 4 &&
            strcmp(e[i].status, "Completed") != 0) {
            critical++;
        }

        if (strcmp(e[i].status, "Pending") == 0) {
            pending++;
        }

        if (strcmp(e[i].status, "Completed") == 0) {
            completed++;
        }

        affected += e[i].people;
    }

    printf("\n");
    showLine();
    printf("               RESQ DASHBOARD\n");
    showLine();
    printf("Total emergencies : %d\n", count);
    printf("Critical cases    : %d\n", critical);
    printf("Pending cases     : %d\n", pending);
    printf("Completed cases   : %d\n", completed);
    printf("People affected   : %d\n", affected);
    showLine();
}

int main(void) {
    int choice;

    while (1) {
        printf("\n\n");
        showLine();
        printf("       RESQ - EMERGENCY RESCUE SYSTEM\n");
        showLine();

        printf("  1. Register Emergency\n");
        printf("  2. View Priority Queue\n");
        printf("  3. Search Emergency\n");
        printf("  4. Update Emergency Status\n");
        printf("  5. View Dashboard\n");
        printf("  6. Exit\n");

        showLine();

        choice = readNumber("Enter your choice (1-6): ", 1, 6);

        switch (choice) {
            case 1:
                registerEmergency();
                break;

            case 2:
                displayEmergencies();
                break;

            case 3:
                searchEmergency();
                break;

            case 4:
                updateStatus();
                break;

            case 5:
                dashboard();
                break;

            case 6:
                printf("\nThank you for using RESQ!\n");
                return 0;
        }
    }
}
